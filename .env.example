# GEMINI_API_KEY: Required for Gemini AI website generation and conversational refinement
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted
APP_URL="MY_APP_URL"

# CLOUDFLARE_PAGES: Optional credentials for deploying directly to Cloudflare Pages (*.pages.dev)
CLOUDFLARE_API_TOKEN="your_cloudflare_api_token_here"
CLOUDFLARE_ACCOUNT_ID="your_cloudflare_account_id_here"

# GITHUB_INTEGRATION: Optional credentials for OAuth repository storage & GitHub Pages
GITHUB_CLIENT_ID="your_github_client_id_here"
GITHUB_CLIENT_SECRET="your_github_client_secret_here"

# SUPABASE: Optional remote database connection
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_ANON_KEY="your_supabase_anon_key"
